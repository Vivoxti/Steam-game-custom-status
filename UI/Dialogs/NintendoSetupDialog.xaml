<Window x:Class="SteamGameCustomStatus.UI.Dialogs.NintendoSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nintendo Switch"
        Width="404"
        SizeToContent="Height"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="BorderStroke" Color="#333333" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#999999" />
        <SolidColorBrush x:Key="BtnBg" Color="#2D2D2D" />
        <SolidColorBrush x:Key="BtnHover" Color="#383838" />
        <SolidColorBrush x:Key="BtnPressed" Color="#252525" />
        <SolidColorBrush x:Key="AccentColor" Color="#60CDFF" />
        <SolidColorBrush x:Key="AccentHover" Color="#78D6FF" />
        <SolidColorBrush x:Key="AccentPressed" Color="#4AB8E8" />
        <SolidColorBrush x:Key="SuccessBg" Color="#13261C" />
        <SolidColorBrush x:Key="SuccessBorder" Color="#245135" />
        <SolidColorBrush x:Key="SuccessText" Color="#89F0AE" />
        <SolidColorBrush x:Key="WarningBg" Color="#2A2114" />
        <SolidColorBrush x:Key="WarningBorder" Color="#5C4420" />
        <SolidColorBrush x:Key="WarningText" Color="#FFD38A" />
        <SolidColorBrush x:Key="InputBg" Color="#2D2D2D" />
        <SolidColorBrush x:Key="InputBgHover" Color="#333333" />
        <SolidColorBrush x:Key="InputBorder" Color="#444444" />
        <SolidColorBrush x:Key="InputBorderHover" Color="#565656" />
        <SolidColorBrush x:Key="InputBorderFocus" Color="#60CDFF" />
        <SolidColorBrush x:Key="SuggestionHoverBg" Color="#2F2F2F" />
        <SolidColorBrush x:Key="SuggestionSelectedBg" Color="#173140" />
        <SolidColorBrush x:Key="SuggestionSelectedBorder" Color="#2F6880" />

        <DropShadowEffect x:Key="WinShadow" BlurRadius="24" ShadowDepth="0" Opacity="0.3" Color="#000000" />

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource BtnBg}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderStroke}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="{StaticResource AccentColor}" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="84" />
        </Style>

        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentColor}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Label" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputChrome" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource InputBgHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderHover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{StaticResource InputBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderFocus}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style x:Key="FriendListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuggestionHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuggestionSelectedBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SuggestionSelectedBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBlock x:Name="Mark"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#000000"
                                           Text="✓"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InputBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentColor}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentColor}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InputBorderFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,4"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuggestionSelectedBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SuggestionSelectedBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InputBorderFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource BorderStroke}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{StaticResource WinShadow}">
        <StackPanel Margin="20,16,20,18">

            <!-- Header (drag area) -->
            <StackPanel Background="Transparent"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Text="Nintendo Switch" />
                <TextBlock Margin="0,6,0,0"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           Text="Shows the game you play on Nintendo Switch as your Steam status. Uses a separate bot Nintendo account that is friends with yours." />
            </StackPanel>

            <!-- Inline error / success card -->
            <Border x:Name="MessageCard"
                    Margin="0,12,0,0"
                    Padding="12,8"
                    Background="{StaticResource WarningBg}"
                    BorderBrush="{StaticResource WarningBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <TextBlock x:Name="MessageText"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="12"
                           Foreground="{StaticResource WarningText}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Section 1: bot account -->
            <TextBlock Margin="0,16,0,6"
                       Style="{StaticResource SectionLabel}"
                       Text="Bot account" />
            <Border Padding="12,10"
                    Background="{StaticResource BtnBg}"
                    BorderBrush="{StaticResource BorderStroke}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="BotNameText"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Checking…" />
                        <TextBlock x:Name="BotDetailText"
                                   Margin="0,2,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button x:Name="SignInButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="Sign in…"
                            Style="{StaticResource SmallBtn}"
                            Click="SignIn_Click" />
                    <Button x:Name="SignOutButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="Sign out"
                            Style="{StaticResource SmallBtn}"
                            Visibility="Collapsed"
                            Click="SignOut_Click" />
                </Grid>
            </Border>

            <!-- Section 2: your account -->
            <DockPanel Margin="0,16,0,6" LastChildFill="False">
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Content="Refresh"
                        Style="{StaticResource LinkBtn}"
                        Click="Refresh_Click" />
                <TextBlock Style="{StaticResource SectionLabel}"
                           Text="Your account" />
            </DockPanel>
            <Border Style="{StaticResource InputChrome}"
                    CornerRadius="8"
                    Padding="4">
                <StackPanel>
                    <ListBox x:Name="FriendsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="160"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource FriendListItemStyle}"
                             SelectionChanged="FriendsListBox_SelectionChanged">
                        <ListBox.Resources>
                            <SolidColorBrush x:Key="ScrollTrackBrush" Color="#2B2B2B" />
                            <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5A5A5A" />
                            <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#75CFF9" />
                            <SolidColorBrush x:Key="ScrollThumbDraggingBrush" Color="#95DCFF" />

                            <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="Thumb">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbRoot"
                                                    Margin="1"
                                                    Background="{StaticResource ScrollThumbBrush}"
                                                    CornerRadius="3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource ScrollThumbDraggingBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="10" />
                                <Setter Property="Margin" Value="6,0,0,0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Width="{TemplateBinding Width}" Background="Transparent">
                                                <Border Margin="2,0"
                                                        Background="{StaticResource ScrollTrackBrush}"
                                                        CornerRadius="3" />
                                                <Track x:Name="PART_Track"
                                                       IsDirectionReversed="True"
                                                       Focusable="False">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource ScrollPageButtonStyle}"
                                                                      Command="ScrollBar.PageUpCommand" />
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb MinHeight="28" />
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource ScrollPageButtonStyle}"
                                                                      Command="ScrollBar.PageDownCommand" />
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PresenceLine"
                                               Margin="0,2,0,0"
                                               Text="{Binding PresenceText}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter TargetName="PresenceLine" Property="Foreground" Value="{StaticResource SuccessText}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="FriendsHintText"
                               Margin="8,6,8,6"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Section 3: enable + interval -->
            <Border Margin="0,16,0,0"
                    Padding="12,10"
                    Background="{StaticResource BtnBg}"
                    BorderBrush="{StaticResource BorderStroke}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <CheckBox x:Name="EnabledCheckBox"
                              Style="{StaticResource CheckRow}"
                              Content="Show my Switch game in Steam" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="Check every" />
                        <RadioButton x:Name="Interval1Radio"
                                     Margin="10,0,0,0"
                                     GroupName="PollInterval"
                                     Tag="60"
                                     Content="1 min"
                                     Style="{StaticResource PillRadio}" />
                        <RadioButton x:Name="Interval2Radio"
                                     Margin="6,0,0,0"
                                     GroupName="PollInterval"
                                     Tag="120"
                                     Content="2 min"
                                     Style="{StaticResource PillRadio}" />
                        <RadioButton x:Name="Interval5Radio"
                                     Margin="6,0,0,0"
                                     GroupName="PollInterval"
                                     Tag="300"
                                     Content="5 min"
                                     Style="{StaticResource PillRadio}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Margin="2,10,2,0"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap"
                       Text="When a new game is detected for the first time, Steam restarts once to add it." />

            <StackPanel Margin="0,14,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="Cancel" Width="80"
                        Style="{StaticResource ActionBtn}"
                        Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="Save" Width="90" Margin="8,0,0,0"
                        Style="{StaticResource AccentBtn}"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
